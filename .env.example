# ---------------------------------------------------------------------------
# Concierge configuration. Copy to .env and fill in what you need.
# Everything has a working default: with no keys at all the stack runs in
# deterministic "offline" mode (rule-based agents, hashing embeddings).
# ---------------------------------------------------------------------------

# --- Models -----------------------------------------------------------------
# auto = use Claude when credentials exist, otherwise offline deterministic agents
LLM_MODE=auto
ANTHROPIC_API_KEY=
# Frontier model for the Booking / Pricing / Policy agents, and its fallback.
AGENT_MODEL=anthropic:claude-opus-5-5
AGENT_FALLBACK_MODEL=anthropic:claude-sonnet-5-5
AGENT_EFFORT=low
# Small model for routing + slot extraction. Options:
#   rules | anthropic:claude-haiku-5-5 | ollama:qwen2.5:3b
ROUTER_MODEL=anthropic:claude-haiku-5-5
OLLAMA_BASE_URL=http://localhost:11434
JUDGE_MODEL=anthropic:claude-sonnet-5-5

# --- Topology ---------------------------------------------------------------
# "inprocess" runs services + MCP inside the gateway process (great for dev).
INVENTORY_URL=inprocess
PRICING_URL=inprocess
RESERVATIONS_URL=inprocess
MCP_URL=inprocess

# --- State ------------------------------------------------------------------
DATA_DIR=./var
# REDIS_URL=redis://localhost:6379/0
# CHECKPOINTER=sqlite            # memory | sqlite | redis | postgres
# MEMORY_DB_URL=postgresql+asyncpg://concierge:concierge@localhost:5432/concierge
# QDRANT_URL=http://localhost:6333
EMBEDDING_PROVIDER=hashing      # hashing | fastembed
RERANKER=heuristic              # heuristic | cross-encoder

# --- Human in the loop -----------------------------------------------------
APPROVAL_SECRET=change-me-in-production
OPERATOR_API_KEY=operator-dev-key

# --- Budgets ----------------------------------------------------------------
TURN_LATENCY_BUDGET_MS=5000
TURN_COST_BUDGET_USD=0.05

# --- Channels ---------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8000
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
META_VERIFY_TOKEN=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=concierge@example.com
STT_PROVIDER=none               # none | faster-whisper
WHISPER_MODEL=base.en

# --- Observability ------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006   # Arize Phoenix / Langfuse / Jaeger (OTLP HTTP)
LOG_LEVEL=INFO
LOG_JSON=false

# Freeze "today" for reproducible demos and evals (YYYY-MM-DD)
# CONCIERGE_TODAY=2026-11-24
